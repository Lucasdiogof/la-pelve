# Copy to web/_headers (Flutter copies it into build/web). Max 100 rules on the Free plan.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  # CSP em modo Report-Only (nao bloqueia nada). Politica candidata: recursos do Flutter (CanvasKit e fontes) hospedados
  # no proprio dominio (build com --no-web-resources-cdn, ver docs/security/CSP_PLAN.md) e Supabase restrito ao projeto.
  # CanvasKit exige wasm-unsafe-eval. A pagina /whatsapp-connect carrega o SDK da Meta e tem politica propria abaixo.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-LEIgqV9+9hWnNcFZ7vYClnAB0Fj6CI1idm4CgGmnQ5g=' 'sha256-Ol/TDVZL5HMcadtrjwdJZXECVzkJCKapJLpdrmH4QvI='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://lchaboncmgcimafpupad.supabase.co; font-src 'self' data:; connect-src 'self' https://lchaboncmgcimafpupad.supabase.co wss://lchaboncmgcimafpupad.supabase.co; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  # Revalidate by default (ETag): Flutter's entry files are NOT content-hashed,
  # so long caching would pin users to an old build. Cheap: asset requests are free.
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=3600
/icons/*
  Cache-Control: public, max-age=86400
/whatsapp-connect*
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-reKghnJ5yvEq3zjNkI5fJRlzjhbOJvdLKkkwvkjU+ZY=' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.facebook.com; connect-src 'self' https://lchaboncmgcimafpupad.supabase.co https://www.facebook.com https://graph.facebook.com; frame-src https://www.facebook.com https://web.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
